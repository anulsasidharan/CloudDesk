# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets. .env.example stays committable.
.env
.env.*
!.env.example

# Runtime databases. Settings default to ./data/*.db.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Test / coverage output
.coverage
htmlcov/

# Logs
*.log

# Frontend (Phase 12)
node_modules/
.next/
# Claude Code: track shared config only
/.claude/*
!/.claude/settings.json
!/.claude/agents/
!/.claude/skills/
!/.claude/rules/
!/.claude/hooks/
.claude/settings.local.json
.claude/transcripts/

# Terraform (Phase 14): var-files, state and plans never get committed
*.tfvars
!*.tfvars.example
backend.hcl
tfplan
*.tfstate
*.tfstate.*
.terraform/
