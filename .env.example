# Copy to .env (git-ignored). Placeholders only - never commit real values.
# Restart the server after changes: get_settings() is cached.

DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me
SUPABASE_JWT_SECRET=

# sqlite+aiosqlite:///./data/support.db  |  postgresql+asyncpg://user:password@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# ./data/checkpoints.db  |  :memory: (tests)
CHECKPOINT_DB_PATH=./data/checkpoints.db

# empty -> fakeredis  |  redis://redis:6379/0
REDIS_URL=
USE_FAKE_REDIS=false

# fake (default, offline) | openai | anthropic | ...
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# memory | qdrant
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
